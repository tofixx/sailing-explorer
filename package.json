{
  "name": "sailing-explorer",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "db:migrate:local": "wrangler d1 migrations apply sailing-explorer --local",
    "db:migrate:remote": "wrangler d1 migrations apply sailing-explorer --remote",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run --mode test",
    "check": "npm run typecheck && npm run test && npm run build",
    "deploy": "npm run build && wrangler d1 migrations apply sailing-explorer --remote && wrangler deploy"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@types/leaflet": "^1.9.22",
    "happy-dom": "^21.0.4",
    "linkedom": "^0.18.14",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7",
    "wrangler": "^4.152.0"
  }
}
