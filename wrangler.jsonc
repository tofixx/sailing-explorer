{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sailing-explorer",
  "account_id": "801ebb5d236032b8396c4ec45dc8df93",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Nur über die eigenen Domains erreichbar (keine *.workers.dev-Adresse) – sonst gäbe es einen Host ohne Weiterleitung
  // mit Produktionsdaten (Passkeys, Cookies).
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Alle Seitenaufrufe laufen zuerst durch den Worker: nur so greift die Weiterleitung von www., Subdomains und der alten
    // Domain auch für „/“ und statische Routen (worker/canonical.ts), und Törn-/Profil-/Boots-/Gruppen-/Hafen-Seiten bekommen
    // ihre Link-Vorschau. Gehashte Bundles, Beispiel-Tracks und das Favicon kommen direkt aus den Assets (keine Worker-Aufrufe).
    // HTML aus dem Asset-Fallback bekommt im Worker dieselben Sicherheits-Header wie in public/_headers (withPageHeaders).
    "run_worker_first": ["/*", "!/assets/*", "!/tracks/*", "!/icons/*", "!/favicon.svg", "!/manifest.webmanifest"]
  },
  // Hauptdomain segeln-potsdam.de; www., alle nicht anders belegten Subdomains (*, proxied) und die alte
  // Domain sailing.wollow.ski leiten per 301 dorthin weiter (worker/canonical.ts). Daten (D1/R2) bleiben dieselben.
  "routes": [
    { "pattern": "segeln-potsdam.de", "custom_domain": true },
    { "pattern": "www.segeln-potsdam.de", "custom_domain": true },
    { "pattern": "sailing.wollow.ski", "custom_domain": true },
    { "pattern": "*.segeln-potsdam.de/*", "zone_name": "segeln-potsdam.de" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sailing-explorer",
      "database_id": "3f944dd1-e65b-4338-a350-9ce2abef4583",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "TRACKS", "bucket_name": "sailing-explorer-tracks" }],
  "ratelimits": [
    { "name": "UPLOAD_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    // Fehlversuche mit Teilen-Schlüssel (nur auf dem 404-Pfad gezählt)
    { "name": "LINK_LIMITER", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    "APP_NAME": "Sail Explorer",
    // resend | cloudflare | log
    "MAIL_PROVIDER": "resend",
    "MAIL_FROM": "Sail Explorer <login@sailing.wollow.ski>",
    // Öffentlicher Turnstile-Site-Key (Dashboard → Turnstile). Lokal überschreibt .dev.vars.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFjg4X6dcj2bWdib",
    // Kostenlose gespeicherte Freigaben pro Konto; darüber braucht es den Unterstützer-Status.
    "FREE_SHARES": "3",
    // Notbremse für den Gesamtspeicher (R2 Free Tier 10 GB): ab soft pausieren neue Uploads kostenloser Konten,
    // ab hard alle. Bytes; nach einem Wechsel auf bezahltes R2 anheben.
    "STORAGE_SOFT_BYTES": "8000000000",
    "STORAGE_HARD_BYTES": "9500000000",
    // Unterstützen braucht die Secrets STRIPE_SECRET_KEY und STRIPE_WEBHOOK_SECRET (siehe README).
    // Moderation (Kommentare & Melden): ADMIN_USER_IDS = kommagetrennte Konto-IDs (Variable oder Secret, leer = keine
    // Admin-Oberfläche) und REPORT_CONTACT = Kontaktadresse für Meldungen ohne Konto (Impressum). Siehe README.
    // Links in Mails aus dem nächtlichen Aufräumen
    "APP_ORIGIN": "https://segeln-potsdam.de",
    "CANONICAL_HOST": "segeln-potsdam.de",
    "ALIAS_HOSTS": "www.segeln-potsdam.de,sailing.wollow.ski"
  },
  // Nächtliches Aufräumen: abgelaufene Törns, Erinnerungsmails, inaktive Konten (UTC)
  "triggers": { "crons": ["17 3 * * *"] },
  "env": {},
  "observability": { "enabled": true }
}
